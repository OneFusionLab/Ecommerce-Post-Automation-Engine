# --- WordPress REST API ---
WP_BASE_URL=https://example.com/wp-json/wp/v2
WP_USERNAME=admin
WP_APPLICATION_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# Optional: a category ID to assign to published posts (defaults to 1)
WP_DEFAULT_CATEGORY=

# --- Playwright ---
# When "true", leave browser visible (headless=False). Good for debugging.
PLAYWRIGHT_HEADLESS=true
# Configure a proxy if required (httpx client config accepts it)
# PROXY_URL=http://user:pass@host:port

# --- Media ---
# Directory where scraped images are downloaded/cached before upload.
MEDIA_DIR=./media

# --- Server ---
# Host/port for the FastAPI dev server (managed via uvicorn).
APP_HOST=127.0.0.1
APP_PORT=8000
